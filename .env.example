# The web UI sends the selected provider key with each local request.
# Keeping keys out of this file is recommended for personal desktop use.
HOST=127.0.0.1
PORT=8765
RELOAD=false
# Local media uploads have no application file size limit.
MAX_CONCURRENT_TASKS=1
TASK_HISTORY_LIMIT=100
# AI_VIDEO_NOTE_WORKSPACE=D:\path\to\workspace
# WHISPER_CACHE_DIR=D:\path\to\faster-whisper-cache
# HF_HUB_DISABLE_XET=1
